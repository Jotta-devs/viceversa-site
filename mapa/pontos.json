    {"id": "lago-leonida", "cat": "natureza", "icone": "agua", "nome_tipo": "oficial", "x": 0.6125, "y": 0.3041, "nome": {"en": "Lake Leonida", "pt-BR": "Lago Leonida", "es": "Lago Leonida"}, "real": {"en": "Lake Okeechobee", "pt-BR": "Lake Okeechobee", "es": "Lake Okeechobee"}, "desc": {"en": "The big lake in the middle of the state, on Ambrosia's doorstep. Its shape and setting echo Lake Okeechobee, the real Florida lake ringed by sugar country.", "pt-BR": "O grande lago no meio do estado, na porta de Ambrosia. O formato e o entorno lembram o Lago Okeechobee, o lago real da Flórida cercado por plantações de cana.", "es": "El gran lago en el centro del estado, a las puertas de Ambrosia. Su forma y su entorno recuerdan al lago Okeechobee, el lago real de Florida rodeado de campos de caña."}, "tags": [{"en": "Ambrosia", "pt-BR": "Ambrosia", "es": "Ambrosia"}], "fontes": ["https://www.rockstargames.com/VI/media", "https://rockstarreport.com/features/gta-6-map-locations-confirmed-leaked-rumoured-leonida"]},
