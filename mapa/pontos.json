    {"id": "allied-crystal", "cat": "industria", "icone": "fabrica", "nome_tipo": "oficial", "x": 0.5527, "y": 0.3661, "nome": {"en": "Allied Crystal sugar refinery", "pt-BR": "Refinaria Allied Crystal", "es": "Refinería Allied Crystal"}, "desc": {"en": "The refinery at the center of Ambrosia's economy. Rockstar describes a town where locals work in the sugar factories and a biker gang takes care of everything else.", "pt-BR": "A refinaria que move a economia de Ambrosia. A Rockstar descreve uma cidade em que os moradores trabalham nas usinas de açúcar e uma gangue de motociclistas cuida do resto.", "es": "La refinería que mueve la economía de Ambrosia. Rockstar describe un pueblo en el que los vecinos trabajan en las fábricas de azúcar y una banda de moteros se encarga del resto."}, "tags": [{"en": "Ambrosia", "pt-BR": "Ambrosia", "es": "Ambrosia"}], "fontes": ["https://www.rockstargames.com/VI/media", "https://www.rockstargames.com/VI"]},
